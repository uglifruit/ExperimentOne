# ============================================================
# Magic Teacher — Environment Variables
# Copy this file to .env.local and fill in the values.
# ============================================================

# ------------------------------------------------------------
# Supabase — MagicTeacherBase project
# Get these from: https://app.supabase.com
#   → Select "MagicTeacherBase" project
#   → Settings (gear icon) → API
# ------------------------------------------------------------

# Project URL  (Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=

# Anon / public key  (Settings → API → Project API keys → "anon public")
# Safe to expose to the browser — enforces Row Level Security
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key  (Settings → API → Project API keys → "service_role")
# ⚠️  KEEP SECRET — bypasses RLS, server-side use only, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------
# After adding the env vars, run the SQL in supabase/schema.sql
# via the Supabase SQL Editor to create the guestbook table.
# ------------------------------------------------------------
